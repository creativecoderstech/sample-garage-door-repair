modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "garage-launch-acceptance"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "garage-launch-acceptance"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --test artifacts/sample-garage-door-repair/cloudflare/*.test.mjs && pnpm --filter @workspace/db test:auth && pnpm --filter @workspace/api-server test:staff-origin && pnpm --filter @workspace/api-server exec tsx --test src/lib/*.test.mjs && node --experimental-strip-types --test artifacts/sample-garage-door-repair/src/lib/*.test.mjs"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
GARAGE_BOOTSTRAP_EMAIL = "creativecoderstech@gmail.com"

[userenv.production]
GARAGE_BOOTSTRAP_EMAIL = "creativecoderstech@gmail.com"

[userenv.shared]
GOOGLE_OAUTH_CLIENT_ID = "846517343389-b9jv5umn8n1v7bc1rqhth60cvdkmh5ku.apps.googleusercontent.com"
