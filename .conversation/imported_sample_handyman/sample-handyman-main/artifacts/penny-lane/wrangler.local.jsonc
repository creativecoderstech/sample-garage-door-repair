{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Local-only wrangler config for Replit dev — NOT committed to git.
  // Generated from wrangler.jsonc env.dev with `ai` and `send_email` stripped
  // (those require a live Cloudflare session / email worker).
  "name": "penny-lane-home-solutions-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "dev",
    "OPENAI_BASE_URL": "https://api.openai.com/v1"
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "penny-lane-db-dev",
      "database_id": "26e948c1-1d74-4d2c-b792-3267ef2b45c0",
      "migrations_dir": "./migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "1a9cd90863b14e0d8bf9200d88e13848"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "penny-lane-media-dev"
    }
  ]
}
