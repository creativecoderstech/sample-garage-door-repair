{
  "name": "@workspace/sample-handyman",
  "version": "1.0.16",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "dev:cf": "pnpm run build:web && wrangler dev --env dev",
    "build": "pnpm run build:web",
    "hydrate": "node ./scripts/hydrate-build-inputs.mjs",
    "build:web": "pnpm run hydrate && vite build --config vite.config.ts",
    "deploy": "pnpm run deploy:prod",
    "deploy:dev": "pnpm run build:web && wrangler deploy --env dev",
    "deploy:prod": "pnpm run build:web && wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 migrations apply sample-handyman-db-dev --local --env dev",
    "sync:prod-to-dev": "bash ./scripts/sync-prod-db-to-dev.sh",
    "sync:prod-media-to-dev": "bash ./scripts/sync-prod-media-to-dev.sh",
    "db:migrate:dev": "wrangler d1 migrations apply sample-handyman-db-dev --remote --env dev",
    "db:migrate:prod": "wrangler d1 migrations apply sample-handyman-db --remote --env production",
    "seed:gallery:dev": "node ./scripts/seed-gallery-defaults.mjs dev",
    "seed:gallery:prod": "node ./scripts/seed-gallery-defaults.mjs production",
    "seed:tasks:dev": "node ./scripts/seed-tasks-defaults.mjs dev",
    "seed:tasks:prod": "node ./scripts/seed-tasks-defaults.mjs production",
    "cf-typegen": "wrangler types --env production",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.component.config.ts",
    "test:component": "vitest run --config vitest.component.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@hookform/resolvers": "3.9.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
