    "wouter": "^3.3.5",
    "wrangler": "^4.118.0",
    "zod": "catalog:"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "hono": "^4.12.33",
    "leaflet": "^1.9.4"
  }
}
