modules = ["nodejs-24", "python-base-3.13"]

[[ports]]
localPort = 5000
externalPort = 80


[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sample Handyman"

[[workflows.workflow]]
name = "Sample Handyman"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/sample-handyman && SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt SSL_CERT_DIR=/etc/ssl/certs npm_config_manage_package_manager_versions=false pnpm exec wrangler dev --config wrangler.local.jsonc --env dev --ip 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
